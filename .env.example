# Google Places API (used by api/search-places.js and api/resolve-place.js)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Firebase Configuration (used by public/index.html - replace placeholders at build time)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin password for /cetak dashboard (verified server-side via api/admin-verify.js)
ADMIN_PASSWORD=ganti-dengan-password-kuat