{
  "public": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/admin-dashboard", "destination": "/dashboard.html" },
    { "source": "/cetak", "destination": "/cetak.html" },
    { "source": "!(*.html|*.png|*.js|*.css)", "destination": "/index.html" }
  ]
}
